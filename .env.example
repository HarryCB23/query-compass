# ============================================================
# Query Compass — environment variable template
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is listed in .gitignore.
# ============================================================

# ── Frontend (Vite, public) ──────────────────────────────────
# Your Supabase project URL (Settings → API)
VITE_SUPABASE_URL=

# Supabase anon/publishable key (Settings → API → anon public)
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Supabase Edge Function secrets ──────────────────────────
# Set these via: npx supabase secrets set KEY=value
# or in the Supabase dashboard (Settings → Edge Functions → Secrets)

# Anthropic Claude API key — used by classify-batch, claude-webhook
ANTHROPIC_API_KEY=

# DataforSEO credentials (https://dataforseo.com)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Shared secret for DataforSEO postback webhook verification
# Generate with: openssl rand -hex 32
DATAFORSEO_WEBHOOK_SECRET=

# Supabase service role key — for edge functions writing to the DB
# (Settings → API → service_role secret)
SUPABASE_SERVICE_ROLE_KEY=

# ── Phase 7 — Google OAuth (GSC integration, not yet implemented) ──
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
